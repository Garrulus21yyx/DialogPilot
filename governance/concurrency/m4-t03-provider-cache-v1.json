{
  "contract_id": "m4-t03-provider-cache-v1",
  "owner": "ProviderCacheGate",
  "modes": ["disabled", "implicit", "explicit"],
  "required_matches": [
    "tenant", "region", "allowed_data_classes", "policy_max_ttl",
    "provider_supported_ttl", "multimodal", "no_training", "zero_retention",
    "deletion_handling", "provider_usage_fields"
  ],
  "default_without_invocation_contract": "DISABLED",
  "stable_prefix_data_classes": ["system", "profile", "tool_schema", "few_shot"],
  "live_suffix_data_classes": [
    "current_input", "service_continuity", "tool_result", "multimodal"
  ],
  "explicit_breakpoints": ["stable_system_prefix", "last_stable_tool_schema"],
  "cache_is_not": ["evidence", "memory", "business-result-cache"],
  "usage_fields": ["cache_creation_input_tokens", "cache_read_input_tokens"],
  "mismatch_outcome": "DISABLED with typed reason; inference payload remains uncached"
}
