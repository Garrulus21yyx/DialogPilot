{
  "contract_id": "m4-t03-tool-result-context-v1",
  "owner": "ReActExecutionEngine provider-step projection",
  "schema_version": "tool-result-context-v1",
  "mandatory_fields": [
    "call_id", "tool_name", "status", "success", "effect_status",
    "receipt_id", "authority", "output_schema_version",
    "receipt_schema_version", "result_locator", "compacted"
  ],
  "full_result_owner": "ToolExecutionLedger via RunStore compatibility port",
  "locator_schema": "react-tool-result:v1/{run_id}/{call_id}",
  "locator_scope": ["user_id", "conversation_id"],
  "step_policy": [
    "checkpoint keeps immutable structured envelopes",
    "provider view removes prior-step excerpts",
    "latest excerpt is bounded to 96 estimated tokens",
    "on pre-call budget rejection remove latest excerpts and retry admission once",
    "receipt and locator are never removed by compaction"
  ],
  "unresolved_after_compaction": "ProviderContextBudgetExceeded before provider side effect"
}
