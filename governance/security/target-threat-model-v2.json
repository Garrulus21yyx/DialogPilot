{
  "model_id": "dialogpilot-target-security-v2",
  "assets": [
    {
      "asset_id": "identity",
      "owner": "Authentication/Application"
    },
    {
      "asset_id": "conversation_memory",
      "owner": "Conversation/Memory"
    },
    {
      "asset_id": "knowledge_evidence",
      "owner": "Knowledge"
    },
    {
      "asset_id": "tool_authority_effect",
      "owner": "Domain Tool"
    },
    {
      "asset_id": "checkpoint",
      "owner": "LangGraph PostgreSQL checkpoint"
    },
    {
      "asset_id": "trace_audit",
      "owner": "Observability/Security"
    },
    {
      "asset_id": "uploaded_source",
      "owner": "Knowledge Ingestion / MediaAsset"
    }
  ],
  "trust_boundaries": [
    {
      "boundary_id": "http_principal",
      "from": "client",
      "to": "Application",
      "authoritative_fact": "signed Principal subject/scopes"
    },
    {
      "boundary_id": "context_data",
      "from": "Memory/Knowledge/Ticket",
      "to": "LLM context",
      "authoritative_fact": "data-only evidence; never instruction/authorization"
    },
    {
      "boundary_id": "tool_call",
      "from": "Agent proposal",
      "to": "Domain Tool",
      "authoritative_fact": "server allowlist/approval/idempotency/receipt"
    },
    {
      "boundary_id": "retrieval_scope",
      "from": "Application identity",
      "to": "Knowledge backend/cache",
      "authoritative_fact": "tenant/user/auth/deletion/generation refs"
    },
    {
      "boundary_id": "checkpoint_projection",
      "from": "Agent Runtime",
      "to": "public/trace",
      "authoritative_fact": "runtime dependencies stay outside model/checkpoint data; authorized working messages remain sensitive"
    },
    {
      "boundary_id": "knowledge_upload",
      "from": "admin upload",
      "to": "SourceRevision",
      "authoritative_fact": "separate knowledge text and authenticated image/PDF validation contracts"
    }
  ],
  "threats": [
    {
      "threat_id": "USER_PROMPT_INJECTION",
      "surface": "authenticated chat message",
      "asset": "system policy/tool authority",
      "owner": "Application Security",
      "applicability": "ACTIVE",
      "abuse_case": "customer asks the model to override policy, exfiltrate prompts or spoof approval",
      "controls": [
        {
          "control_id": "ingress-pattern-guard",
          "kind": "PREVENT",
          "owner": "InputSecurity",
          "evidence_refs": [
            "tests/test_input_security.py:test_chat_blocks_before_memory_llm_and_tool_boundaries"
          ]
        },
        {
          "control_id": "framework-role-boundary",
          "kind": "PREVENT",
          "owner": "TargetFrameworkAgent",
          "evidence_refs": [
            "tests/test_target_framework_agent.py:test_framework_keeps_user_input_out_of_system_policy"
          ]
        },
        {
          "control_id": "guard-diagnostics",
          "kind": "DETECT",
          "owner": "InputSecurity",
          "evidence_refs": [
            "tests/test_input_security.py:test_guard_stats_contain_counts_but_never_prompt_content"
          ]
        }
      ],
      "disable_action": "block chat at ingress; keep tools unreachable",
      "residual_risk": "pattern guard is defense-in-depth; hard authorization remains server-owned"
    },
    {
      "threat_id": "INDIRECT_CONTEXT_INJECTION",
      "surface": "Memory/RAG/Ticket/tool output",
      "asset": "LLM decision and tool proposal",
      "owner": "Context + Tool Runtime",
      "applicability": "ACTIVE",
      "abuse_case": "stored or retrieved data contains role/instruction text that attempts to become policy",
      "controls": [
        {
          "control_id": "tool-data-quarantine",
          "kind": "PREVENT",
          "owner": "ToolManager",
          "evidence_refs": [
            "tests/test_tool_security_trace.py:test_indirect_prompt_injection_in_tool_output_is_quarantined"
          ]
        },
        {
          "control_id": "context-data-quarantine",
          "kind": "PREVENT",
          "owner": "ContextAssembler",
          "evidence_refs": [
            "tests/test_context_memory.py:test_indirect_prompt_injection_sections_are_quarantined_not_rendered"
          ]
        },
        {
          "control_id": "media-data-provenance",
          "kind": "DETECT",
          "owner": "TargetFrameworkAgent",
          "evidence_refs": [
            "tests/test_target_media_context.py:test_ocr_evidence_reaches_framework_as_tool_data_with_provenance"
          ]
        }
      ],
      "disable_action": "disable affected capability or corpus; preserve evidence for diagnosis without a legacy fallback",
      "residual_risk": "novel semantic attacks may evade patterns; deterministic authority gates still constrain effects"
    },
    {
      "threat_id": "CROSS_TENANT_ACCESS",
      "surface": "conversation/retrieval/cache/tool identity",
      "asset": "tenant/user data",
      "owner": "Application + Platform",
      "applicability": "ACTIVE",
      "abuse_case": "body IDs, cache keys or backend filters select another tenant/user",
      "controls": [
        {
          "control_id": "principal-owned-subject",
          "kind": "PREVENT",
          "owner": "Authentication",
          "evidence_refs": [
            "tests/test_auth_boundary.py"
          ]
        },
        {
          "control_id": "scoped-storage-and-cache",
          "kind": "PREVENT",
          "owner": "Platform",
          "evidence_refs": [
            "tests/test_postgres_conversation_store.py",
            "tests/test_hybrid_retrieval_backends.py",
            "tests/test_knowledge_retriever.py"
          ]
        },
        {
          "control_id": "cross-scope-negative-tests",
          "kind": "DETECT",
          "owner": "Evaluation",
          "evidence_refs": [
            "tests/test_postgres_conversation_query.py"
          ]
        }
      ],
      "disable_action": "stop affected admission and revoke backend credentials",
      "residual_risk": "production database role/RLS verification remains deployment evidence"
    },
    {
      "threat_id": "APPROVAL_PRIVILEGE_REPLAY",
      "surface": "tool approval resume",
      "asset": "business write authority",
      "owner": "ConversationState / GovernedWriteRuntime",
      "applicability": "ACTIVE",
      "abuse_case": "another user, expired approval or altered parameters resumes a privileged call",
      "controls": [
        {
          "control_id": "principal-bound-approval",
          "kind": "PREVENT",
          "owner": "ConversationState",
          "evidence_refs": [
            "tests/test_conversation_state_resolution.py:test_approval_is_bound_to_identity_and_transitions_only_its_workstream"
          ]
        },
        {
          "control_id": "stale-or-expired-approval",
          "kind": "PREVENT",
          "owner": "ConversationState",
          "evidence_refs": [
            "tests/test_conversation_state_resolution.py:test_pending_approval_requires_explicit_id_and_rejects_stale_signal",
            "tests/test_conversation_state_resolution.py:test_expired_approval_fails_before_state_consumption"
          ]
        },
        {
          "control_id": "altered-write-binding",
          "kind": "DETECT",
          "owner": "OperationLedger",
          "evidence_refs": [
            "tests/test_write_workflow.py:test_operation_binding_survives_a_new_turn_snapshot_but_rejects_changed_arguments"
          ]
        }
      ],
      "disable_action": "block affected write capability; keep unrelated reads available and retain approvals/receipts for investigation",
      "residual_risk": "unknown effect remains RECONCILING; it is never retried from local inference"
    },
    {
      "threat_id": "CHECKPOINT_TRACE_DISCLOSURE",
      "surface": "LangGraph PostgreSQL checkpoint, public invocation views and trace",
      "asset": "conversation PII, server secrets and tool diagnostics",
      "owner": "TargetFrameworkAgent / LangGraph / Observability",
      "applicability": "ACTIVE",
      "abuse_case": "checkpoint or trace projection exposes prompts, credentials, PII or tool outputs",
      "controls": [
        {
          "control_id": "runtime-context-isolation",
          "kind": "PREVENT",
          "owner": "TargetFrameworkAgent",
          "evidence_refs": [
            "tests/test_target_framework_agent.py:test_postgres_subgraph_survives_process_exit_after_tool"
          ]
        },
        {
          "control_id": "trace-value-redaction",
          "kind": "PREVENT",
          "owner": "TraceRecorder",
          "evidence_refs": [
            "tests/test_tool_security_trace.py:test_trace_attributes_redact_secret_and_pii_values"
          ]
        },
        {
          "control_id": "correlated-sanitized-audit",
          "kind": "DETECT",
          "owner": "ToolManager",
          "evidence_refs": [
            "tests/test_tool_security_trace.py:test_trace_context_propagates_to_parallel_tool_calls_and_redacts_audit"
          ]
        }
      ],
      "disable_action": "disable trace export/checkpoint admission; rotate exposed credentials",
      "residual_risk": "credential sentinel verifies runtime-context separation only; authorized conversation/tool contents remain sensitive in PostgreSQL and require deployment access/retention controls"
    },
    {
      "threat_id": "ATTACHMENT_POLYGLOT",
      "surface": "knowledge text uploads and authenticated media assets",
      "asset": "Knowledge source corpus",
      "owner": "Knowledge Ingestion / MediaAsset",
      "applicability": "ACTIVE",
      "abuse_case": "binary/archive/executable content is renamed to an accepted text suffix",
      "controls": [
        {
          "control_id": "text-upload-policy",
          "kind": "PREVENT",
          "owner": "Knowledge Ingestion",
          "evidence_refs": [
            "core/upload_security.py",
            "tests/test_knowledge_ingestion_api.py"
          ]
        },
        {
          "control_id": "media-quarantine",
          "kind": "DETECT",
          "owner": "MediaAsset",
          "evidence_refs": [
            "tests/test_media_asset_api.py:test_quarantined_asset_is_not_returned_as_ready"
          ]
        }
      ],
      "disable_action": "remove knowledge upload route at ingress and quarantine new revisions",
      "residual_risk": "format checks do not prove absence of malware or adversarial pixels; parser/provider behavior requires separate assurance"
    },
    {
      "threat_id": "VLM_HIDDEN_INSTRUCTION",
      "surface": "QR/screenshot/media instruction",
      "asset": "tool authority and user safety",
      "owner": "Multimodal + Security",
      "applicability": "ACTIVE",
      "abuse_case": "VLM treats pixels or OCR text as executable instruction",
      "controls": [
        {
          "control_id": "observation-not-policy",
          "kind": "PREVENT",
          "owner": "TargetFrameworkAgent",
          "evidence_refs": [
            "tests/test_target_media_context.py:test_ocr_evidence_reaches_framework_as_tool_data_with_provenance"
          ]
        },
        {
          "control_id": "output-shape-validation",
          "kind": "PREVENT",
          "owner": "VisionProvider",
          "evidence_refs": [
            "tests/test_deepseek_vision_provider.py:test_invalid_model_outputs_fail_closed"
          ]
        },
        {
          "control_id": "instruction-output-quarantine",
          "kind": "DETECT",
          "owner": "ToolManager",
          "evidence_refs": [
            "tests/test_target_media_context.py:test_instruction_bearing_ocr_output_is_quarantined_by_tool_owner"
          ]
        }
      ],
      "disable_action": "disable affected VLM/media capability without disabling unrelated read tasks",
      "residual_risk": "tests use controlled model/OCR outputs; they do not prove resistance to novel hidden-pixel/QR attacks or certify a live model"
    },
    {
      "threat_id": "WRITE_EFFECT_REPLAY",
      "surface": "write timeout, process exit, revision change and resume",
      "asset": "business side effect",
      "owner": "GovernedWriteRuntime / PostgreSQL OperationLedger / Business Tool",
      "applicability": "ACTIVE",
      "abuse_case": "resuming or correcting a task resubmits an already committed or unknown write",
      "controls": [
        {
          "control_id": "operation-claim",
          "kind": "PREVENT",
          "owner": "OperationLedger",
          "evidence_refs": [
            "tests/test_write_workflow.py:test_concurrent_duplicate_operation_executes_the_side_effect_once"
          ]
        },
        {
          "control_id": "unknown-effect-reconciliation",
          "kind": "PREVENT",
          "owner": "GovernedWriteRuntime",
          "evidence_refs": [
            "tests/test_write_workflow.py:test_recreated_runtime_reconciles_unfinished_writes_without_resubmission"
          ]
        },
        {
          "control_id": "correction-after-submit",
          "kind": "DETECT",
          "owner": "WorkControl",
          "evidence_refs": [
            "tests/test_write_workflow.py:test_correction_after_write_submission_enters_reconciliation",
            "tests/test_work_control.py:test_publication_boundary_rejects_a_superseded_revision"
          ]
        }
      ],
      "disable_action": "disable write tool, preserve ledger and reconcile by authoritative receipt",
      "residual_risk": "provider without authoritative receipt stays blocked/reconciling rather than guessed terminal"
    }
  ]
}
