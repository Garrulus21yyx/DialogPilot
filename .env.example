# DialogPilot 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=DialogPilot
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# 逗号分隔的浏览器来源；空值表示不允许跨域调用
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── DeepSeek（通过 Anthropic Messages 兼容端点）──────────────────────────────
# 变量名保留 ANTHROPIC_API_KEY 是因为底层使用 Anthropic SDK；值填写 DeepSeek Key。
MODEL_PROVIDER=deepseek
ANTHROPIC_API_KEY=your_deepseek_api_key_here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 高频、闭合任务：Flash + 禁用 thinking，降低延迟和成本。
MODEL_INTENT=deepseek-v4-flash
MODEL_INTENT_REASONING=none
MODEL_WORKER=deepseek-v4-flash
MODEL_WORKER_REASONING=none
MODEL_REACT=deepseek-v4-flash
MODEL_REACT_REASONING=none
MODEL_MEMORY=deepseek-v4-flash
MODEL_MEMORY_REASONING=none
MODEL_REWRITE=deepseek-v4-flash
MODEL_REWRITE_REASONING=none
MODEL_RERANK=deepseek-v4-flash
MODEL_RERANK_REASONING=none

# 在线融合和质量门禁：Pro 但禁用 thinking，避免把高推理尾延迟带入请求路径。
MODEL_SYNTHESIS=deepseek-v4-pro
MODEL_SYNTHESIS_REASONING=none
MODEL_VERIFIER=deepseek-v4-pro
MODEL_VERIFIER_REASONING=none
# 结构化 Judge 也默认禁用 thinking；需要研究型裁决时再显式开启并提高预算。
MODEL_JUDGE=deepseek-v4-pro
MODEL_JUDGE_REASONING=none

# 任一角色改成 low/high/max 时，还必须设置同名 token floor（至少 256）。
# 三档消融为避免 thinking 吃完最终文本预算使用 1024，例如：
# MODEL_INTENT_MIN_COMPLETION_TOKENS=1024
# MODEL_REACT_MIN_COMPLETION_TOKENS=1024

# 使用原生 Anthropic 时设 MODEL_PROVIDER=anthropic，并用此变量作为所有角色后备模型。
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── DeepSeek 视觉模型（显式启用；L0/L1 永远不会调用）──────────────────────
# 传输使用 DeepSeek 官方 Anthropic Messages image content 协议。
VLM_ENABLED=false
MODEL_VISION=deepseek-v4-flash-vision-exp
# 留空时复用 ANTHROPIC_API_KEY；如视觉模型使用独立 Key，可在此覆盖。
VLM_API_KEY=
VLM_BASE_URL=https://api.deepseek.com/anthropic
VLM_MAX_TOKENS=512

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=dialogpilot-local

# ── PostgreSQL Retrieval ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://dialogpilot:dialogpilot-local@localhost:15432/dialogpilot
RETRIEVAL_DATABASE_URL=postgresql://dialogpilot:dialogpilot-local@localhost:15432/dialogpilot
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_CHUNK_STRATEGY=structure_aware
# Doc2Dial Dev 选择的公共知识检索基线；长期记忆使用独立权重。
RAG_RRF_K=10
RAG_VECTOR_WEIGHT=0.25
RAG_LEXICAL_WEIGHT=0.75
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_CONTEXT_MAX_TOKENS=2600
RAG_RAW_QUERY_WEIGHT=0.25
RAG_STANDALONE_QUERY_WEIGHT=0.75

# Knowledge 和 ServiceEpisode 可分别从明确的 hash baseline 切换到
# bge_m3。任一路选 bge_m3 时都必须提供下列本地固定权重配置；
# 缺失或加载失败会终止启动，不回退 hash，不联网下载。
KNOWLEDGE_DENSE_EMBEDDING_PROVIDER=hash_baseline
SERVICE_EPISODE_DENSE_EMBEDDING_PROVIDER=hash_baseline
# BGE_M3_LOCAL_MODEL_PATH=/srv/dialogpilot/models/bge-m3
# BGE_M3_HOST_MODEL_PATH=/absolute/host/path/to/pinned-bge-m3
# BGE_M3_MODEL_REVISION=<pinned-upstream-commit>
# BGE_M3_MODEL_SHA256=<verified-local-artifact-sha256>
# BGE_M3_DEVICE=cpu
# BGE_M3_BATCH_SIZE=32

# ngram: LLM + 本地字符 n-gram + 规则；disabled: 仅 LLM + 规则。
INTENT_SIMILARITY_MODE=ngram
# 进程内意图结果缓存；低置信度与账户安全结果会自动收紧到最多 300 秒。
INTENT_CACHE_TTL_SECONDS=3600

# command-primary 迁移默认关闭。structured_knowledge_primary 只开放已验收的
# 知识问答正确性路径：Encoder 固定 DEFER，由结构化 LLM 产生 command。
# shadow/knowledge_primary 仅保留给既有迁移对照，不是最终 Intent 架构。
COMMAND_PRIMARY_MODE=off

# ── 人工工单与服务承诺 ──────────────────────────────────────────────────────────────
# 可选外部 CRM webhook；为空时工单与 outbox 仍原子落库，事件保持 pending。
TICKET_DISPATCH_WEBHOOK_URL=
TICKET_DISPATCH_TIMEOUT_SECONDS=5
TICKET_DISPATCH_POLL_SECONDS=5
TICKET_DISPATCH_LEASE_SECONDS=30
TICKET_DISPATCH_RETRY_BASE_SECONDS=5
TICKET_DISPATCH_RETRY_MAX_SECONDS=300
COMMITMENT_DUE_POLL_SECONDS=1
# 本地订单/退款/安全事件业务沙箱；生产可替换为外部 CRM/订单系统适配器
CUSTOMER_OPERATIONS_DB_PATH=./data/customer-operations/operations.db
REACT_RUN_DB_PATH=./data/react-runs/react-runs.db
REACT_APPROVAL_TTL_SECONDS=900
REACT_RECOVERY_GRACE_SECONDS=30

# DialogPilot API 的宿主端口；容器内仍监听 8000
DIALOGPILOT_API_PORT=18000

# ── 上下文预算 ─────────────────────────────────────────────────────────────────────
CONTEXT_INPUT_BUDGET=12000
CONTEXT_OUTPUT_RESERVE=1536
MEMORY_TOKEN_BUDGET=6000
MEMORY_COMPRESSION_THRESHOLD=0.70
MEMORY_SUMMARY_MAX_TOKENS=1200
MEMORY_FACT_IDLE_SECONDS=300
MEMORY_FACT_BATCH_TURNS=3
MEMORY_FACT_WORKER_POLL_SECONDS=5
AGENT_TIMEOUT_SECONDS=15
AGENT_REQUEST_TIMEOUT_SECONDS=20
AGENT_MAX_PER_REQUEST=3

# ── ReAct 工具执行 ────────────────────────────────────────────────────────────
# 每个领域 Worker 的最大 LLM/tool 循环步数
REACT_MAX_STEPS=4
# default: 高风险/写工具待宿主批准；require_all: 全部待批准；auto_approve: 仅可信环境
TOOL_APPROVAL_MODE=default
# 工具结果回写模型前的最大字符数
TOOL_OUTPUT_MAX_CHARS=4000

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0
# Span 默认脱敏后持久化到 PostgreSQL；配置以下凭据可额外发送到 Langfuse v4。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
TRACE_RETENTION_DAYS=7

# ── 评测 ──────────────────────────────────────────────────────────────────────
# 线上 Bad Case 生命周期与审计；Compose 会覆盖为独立持久卷路径
BADCASE_DB_PATH=./data/badcases/badcases.db
# 用户标识 HMAC 盐；缺省复用 JWT secret，生产建议单独由 secret manager 注入
BADCASE_IDENTITY_SALT=replace_with_a_separate_32_byte_secret
# Docker 构建时注入当前 Git SHA；本地 compose 未设置时显示 local
GIT_COMMIT_SHA=local

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
DIALOGPILOT_SKILLS_DIR=./skills
DIALOGPILOT_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
# 至少 32 字节；生产由 secret manager 注入，不提交真实值
AUTH_JWT_SECRET=replace_with_at_least_32_random_bytes
AUTH_JWT_ISSUER=dialogpilot
AUTH_JWT_AUDIENCE=dialogpilot-api

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
